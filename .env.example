# Docker Compose values. Copy to .env at project root.
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=local-taskflow-password
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8001
